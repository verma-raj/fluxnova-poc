# Read by `docker compose`. Copy this file to `.env` (which git ignores) and set real values.

# Host folder that contains fluxnova-engine.yml; mounted read-only into the container at /config.
FLUXNOVA_ENGINE_CONFIG_DIR=C:/Users/rajivnayan.verma/tenant-endpoint

# Host folder that contains the Fluxnova container's tenants.yml (the tenant list); mounted read-only at /configs in
# fluxnova-application, which watches it: a tenant added there is onboarded, a tenant removed is offboarded (DB dropped).
# Its cluster section must name this setup's database server: host "fluxnovadb", admin-database "fluxnovadb".
# Default if unset: ./topology/fluxnova-config
FLUXNOVA_TENANTS_DIR=C:/Users/rajivnayan.verma/fluxconfig

# Credentials of the Fluxnova engines' REST API (HTTP Basic); used for every tenant that does not name its own.
# Wrap the password in single quotes if it contains # or spaces.
FLUXNOVA_REST_USER=admin
FLUXNOVA_REST_PASSWORD=change-me

# PostgreSQL container workerPostgresClusterDB (database workerdb): the BUSINESS data of the workers. The superuser and its
# password; only isaworkercontainer is connected to this server. Wrap the password in single quotes if it contains # or spaces.
WORKERDB_USER=postgres_admin
WORKERDB_PASSWORD=change-me

# PostgreSQL container fluxnovadb: Fluxnova's OWN database server (the tenant engine databases; no business data).
FLUXNOVADB_USER=postgres_admin
FLUXNOVADB_PASSWORD=change-me

# Shared secret of isaworkercontainer and the dialog agent on the desktop (run-dialog-agent.ps1). Use a long random value.
ISAWORKER_DIALOG_TOKEN=change-me-to-a-long-random-value
