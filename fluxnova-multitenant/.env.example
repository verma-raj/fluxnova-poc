# Read by `docker compose`. Copy this file to `.env` (which git ignores) and set real values.
# On AWS ECS inject the password from Secrets Manager instead of using a file.

# Platform administrator: created in every tenant engine, and the only sign-in at "/" while no tenant exists.
FLUXNOVA_WEB_ADMIN_USER=admin
FLUXNOVA_WEB_ADMIN_PASSWORD=change-me

# Folder on the host that contains tenants.yml; it is mounted read-only into the container at /configs.
FLUXNOVA_CONFIG_DIR=./fluxconfig

# Folder on the host for the tenants' .bpmn files; mounted (writable) at /config/bpmn_deployment. The application creates a
# sub-folder named after each tenant in it when the tenant is onboarded; a .bpmn file that lands in a tenant's sub-folder is
# deployed to that tenant only and started.
FLUXNOVA_BPMN_DIR=./bpmn_deployment
